{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    { "src": "/Poulailler-Ste-Marie.html", "dest": "/index.html" },
    { "src": "/poulailler", "dest": "/index.html" },
    { "src": "/sw.js", "headers": { "cache-control": "public, max-age=0, must-revalidate", "Service-Worker-Allowed": "/" }, "dest": "/sw.js" },
    { "src": "/manifest.json", "headers": { "cache-control": "public, max-age=3600" }, "dest": "/manifest.json" },
    { "src": "/(.*)", "dest": "/$1" },
    { "src": "/", "dest": "/index.html" }
  ]
}
